{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr new *)",
      "Bash(gh alias set *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo create *)",
      "Bash(gh auth token*)",
      "Bash(gh auth git-credential*)",
      "Bash(*git-publish.sh enable*)",
      "Bash(*git-publish.sh disable*)",
      "Bash(*git-publish.registry*)",
      "Bash(sudo *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.pypirc)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/git-publish.registry)",
      "Edit(~/.claude/git-publish.registry)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/config)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-write.sh"
          }
        ]
      }
    ]
  },
  "model": "opus"
}
